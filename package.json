    "@dcl/ui-env": "^2.0.0",
    "@reduxjs/toolkit": "2.11.2",
    "decentraland-connect": "^11.2.0",
    "decentraland-crypto-fetch": "^2.0.1",
    "decentraland-ui2": "^1.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
